{
  "schema_version": 2,
  "model": "owner-controlled-agent-remediation",
  "change_risks": [
    "LOW",
    "MEDIUM",
    "HIGH",
    "PROTECTED"
  ],
  "presets": {
    "REPORT_ONLY": {
      "auto_change_risks": [],
      "description": "QA may inspect/test/report only; product remediation is not authorized."
    },
    "SAFE_FIXES": {
      "auto_change_risks": [
        "LOW"
      ],
      "description": "Only unambiguous reversible LOW change-risk remediation may be automatic."
    },
    "ACTIVE_REMEDIATION": {
      "auto_change_risks": [
        "LOW",
        "MEDIUM"
      ],
      "description": "LOW/MEDIUM change-risk remediation may be automatic only when evidence proves expected behavior and the proposed change is reversible; HIGH/PROTECTED or irreversible changes require explicit approval."
    },
    "CUSTOM": {
      "auto_change_risks": [],
      "description": "Owner-selected categories/risks, capped by hard boundaries."
    }
  },
  "auto_change_categories": [
    "documentation",
    "tests",
    "source_code",
    "local_non_secret_config",
    "dependency_hygiene"
  ],
  "hard_boundaries": [
    "material_product_intent",
    "architecture",
    "public_api_contracts",
    "security_policy",
    "privacy_policy",
    "authentication_semantics",
    "authorization_semantics",
    "database_schema",
    "migrations",
    "production_data",
    "credentials",
    "deployments",
    "production",
    "billing_or_paid_calls",
    "destructive_operations",
    "ci_workflow_or_runner_configuration",
    "qa_authority_or_policy",
    "version_control_metadata"
  ],
  "rules": {
    "agent_may_never_self_elevate": true,
    "owner_approval_required_for_policy_mutation": true,
    "agent_may_act_more_conservatively_than_policy": true,
    "severity_is_not_change_risk": true,
    "hard_boundaries_override_all_presets": true,
    "unknown_change_risk_requires_approval": true,
    "ambiguous_expected_behavior_requires_approval": true,
    "all_automatic_changes_must_be_reversible": true,
    "automatic_change_requires_finding_evidence_and_authorization_id": true,
    "automatic_change_requires_declared_target_paths": true
  },
  "protected_path_prefixes": [
    ".comprehensive-qa",
    ".git",
    ".hg",
    ".svn",
    ".github",
    ".circleci",
    ".buildkite",
    ".teamcity",
    ".ssh",
    ".aws",
    ".azure",
    ".kube",
    "secrets",
    "credentials"
  ],
  "protected_path_basenames": [
    ".gitlab-ci.yml",
    "jenkinsfile",
    "azure-pipelines.yml",
    "bitbucket-pipelines.yml",
    "codeowners",
    ".npmrc",
    ".pypirc",
    ".netrc",
    "id_rsa",
    "id_ed25519",
    "credentials.json",
    "service-account.json"
  ],
  "protected_path_suffixes": [
    ".key",
    ".pem",
    ".p12",
    ".pfx",
    ".jks",
    ".keystore"
  ],
  "protected_path_name_prefixes": [
    ".env"
  ]
}

{
  "schema_version": 2,
  "repository": "Isra604/comprehensive-qa-gate-system",
  "channel": "stable",
  "release_source": "github_releases",
  "current_visibility": "public",
  "private_channel_requires_github_authentication": false,
  "public_channel_supports_anonymous_checks": true,
  "check_interval_hours": 24,
  "interactive_update_required": true,
  "verify_sha256": true,
  "backup_before_update": true,
  "preserve_directories": [
    "profile",
    "reports",
    "evidence",
    "artifacts",
    "remediation",
    "dispositions",
    "state"
  ],
  "preserve_files": [
    "config/default.yaml"
  ],
  "managed_paths": [
    "OPEN_DASHBOARD.cmd",
    "dashboard",
    "AGENT_INSTRUCTIONS.md",
    "agent-guides",
    "START_HERE.md",
    "gates",
    "templates",
    "tools",
    "config/update.json",
    "LICENSE",
    "NOTICE",
    "CREDITS.md",
    "TERMS_OF_USE.md",
    "DISCLAIMER.md",
    "DATA_RESPONSIBILITY_NOTICE.md",
    "HUMAN_ACCEPTANCE.md",
    "TERMS_VERSION",
    "LEGAL_MANIFEST.json"
  ],
  "reliability_model": {
    "gate_count": 25,
    "lens_count": 9,
    "compatibility_layout": "gates/lenses",
    "policy": "gates/reliability.yaml"
  }
}
